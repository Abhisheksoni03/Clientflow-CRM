PORT=5000
# Add your own MongoDB Atlas connection string. Do not commit real credentials.
MONGODB_URI=
JWT_SECRET=
# Comma-separated list; include the address used to open the frontend.
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
# Optional SMTP settings; needed only to send password-reset emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Defaults to the first CLIENT_ORIGIN when blank.
PASSWORD_RESET_APP_URL=
